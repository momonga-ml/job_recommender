# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_recommender

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Job Recommender

# Cache Configuration
DEFAULT_CACHE_TTL=3600
LONG_CACHE_TTL=86400
SHORT_CACHE_TTL=300

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI Configuration (for enhanced resume parsing)
OPENAI_API_KEY=your-openai-api-key-here

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# File Upload Settings
MAX_FILE_SIZE=5242880  # 5MB in bytes
UPLOAD_DIRECTORY=uploads/resumes

# Rate Limiting
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=3600
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=900

# External APIs (for job scraping)
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
INDEED_API_KEY=
GLASSDOOR_API_KEY=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000