# ================================
# Job Recommender Configuration
# ================================

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_api_key_here

# Analysis Settings
MAX_SKILLS_TO_ANALYZE=20
MODEL_NAME=gpt-4-turbo-preview

# Scraping Configuration
DEFAULT_CACHE_DURATION=24
DEFAULT_MAX_WORKERS=3
DEFAULT_OUTPUT_DIR=job_descriptions
DEFAULT_CACHE_DIR=.cache

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=job_recommender.log

# Selenium Configuration
HEADLESS_MODE=true
PAGE_TIMEOUT=10
IMPLICIT_WAIT=5

# Site-specific settings
INDEED_BASE_URL=https://www.indeed.com
LINKEDIN_BASE_URL=https://www.linkedin.com
GLASSDOOR_BASE_URL=https://www.glassdoor.com

# Rate Limiting (requests per minute)
INDEED_RATE_LIMIT=60
LINKEDIN_RATE_LIMIT=30
GLASSDOOR_RATE_LIMIT=30

# Optional: Custom User-Agent
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36" 